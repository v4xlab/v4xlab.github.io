<div class="service">
  {% if site.service != blank %}
    {% assign service_items = site.service | sort: 'order' %}
    {% if include.limit %}
      {% assign service_items = service_items | where_exp: 'item', 'item.homepage == true' %}
    {% endif %}
    <ul>
      {% for item in service_items %}
        <li>{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No service listed so far...</p>
  {% endif %}
</div>
