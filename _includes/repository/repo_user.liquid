<a class="repo-card repo-user-card" href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer">
  <img
    class="repo-avatar"
    src="https://github.com/{{ include.username }}.png?size=160"
    alt="{{ include.username }}"
    width="80"
    height="80"
    loading="lazy"
  >
  <div class="repo-user-name">{{ include.username }}</div>
</a>
