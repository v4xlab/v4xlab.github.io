{% assign repo_url = include.repository.repo | split: '/' %}
<a class="repo-card repo-repo-card" href="https://github.com/{{ include.repository.repo }}" target="_blank" rel="noopener noreferrer">
  <div class="repo-repo-name">{{ repo_url[1] }}</div>
  {% if include.repository.description %}
    <div class="repo-repo-desc">{{ include.repository.description }}</div>
  {% endif %}
  <div class="repo-repo-meta">
    {% if include.repository.language %}
      <span class="repo-lang">{{ include.repository.language }}</span>
    {% endif %}
    {% if include.repository.stars %}
      <span class="repo-stars">&#9733; {{ include.repository.stars }}</span>
    {% endif %}
  </div>
</a>
