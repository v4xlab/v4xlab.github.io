<div class="patents">
  {% if site.data.patents %}
    <ol class="patent-list">
      {% for patent in site.data.patents %}
        <li>
          <div class="patent-title">{{ patent.title }}</div>
          <div class="patent-authors">{{ patent.authors }}</div>
          {% if patent.number %}
            <div class="patent-number">{{ patent.number }}</div>
          {% endif %}
          {% if patent.status %}
            <div class="patent-status">
              <em>{{ patent.status }}</em>
            </div>
          {% endif %}
          {% if patent.paper or patent.patent %}
            <div class="patent-links">
              {% if patent.patent %}
                <a href="{{ patent.patent }}" class="btn btn-sm z-depth-0" role="button">Patent</a>
              {% endif %}
              {% if patent.paper %}
                <a href="{{ patent.paper }}" class="btn btn-sm z-depth-0" role="button">Paper</a>
              {% endif %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p>No patents listed so far...</p>
  {% endif %}
</div>
