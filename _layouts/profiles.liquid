---
layout: page
---
<div class="post">
  <article>
    {% if page.profiles %}
      {% for profile in page.profiles %}
        <hr>
        <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if profile.image %}
            {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
            {% if profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
            {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
          {% endif %}
          {% if profile.more_info %}
            <div class="more-info">{{ profile.more_info }}</div>
          {% endif %}
        </div>

        <div class="clearfix">
          {% if profile.content %}
            {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
            {{ profile_content | markdownify }}
          {% else %}
            {{ content }}
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}

    {% if site.data.phd_students %}
      <hr>
      <h2>PhD Students</h2>
      <div class="team-rows">
        {% for student in site.data.phd_students %}
          <div class="team-row">
            {% if student.photo %}
              <img
                class="team-row-photo"
                src="{{ student.photo }}"
                alt="{{ student.name }}"
                width="150"
                height="150"
                loading="lazy"
              >
            {% endif %}
            <div class="team-row-content">
              <div class="team-row-name">
                {% if student.website %}
                  <a href="{{ student.website }}" target="_blank" rel="noopener noreferrer">{{ student.name }}</a>
                {% else %}
                  {{ student.name }}
                {% endif %}
              </div>
              <div class="team-row-years">
                PhD Student{% if student.years %}, {{ student.years }}{% endif %}
              </div>
              {% if student.blurb %}
                <div class="team-row-blurb">{{ student.blurb }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if site.data.ms_students %}
      <hr>
      <h2>Master's Students</h2>
      <ul class="team-list">
        {% for student in site.data.ms_students %}
          <li>
            {{ student.name -}}
            {%- if student.years %}
              <span class="team-role">({{ student.years }})</span>
            {%- endif -%}
            {%- if student.note %}
              &mdash; {{ student.note }}
            {%- endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if site.data.ug_students %}
      <hr>
      <h2>Undergraduate Students</h2>
      <ul class="team-list">
        {% for student in site.data.ug_students %}
          <li>
            {{ student.name -}}
            {%- if student.years %}
              <span class="team-role">({{ student.years }})</span>
            {%- endif -%}
            {%- if student.note %}
              &mdash; {{ student.note }}
            {%- endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if site.data.external_collaborators %}
      <hr>
      <h2>External Collaborators &amp; Interns</h2>
      <ul class="team-list">
        {% for person in site.data.external_collaborators %}
          <li>
            {{ person.name -}}
            {%- if person.affiliation %}
              <span class="team-role">({{ person.affiliation }})</span>
            {%- endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if site.data.former_members %}
      <hr>
      <h2>Former Members</h2>
      <ul class="team-list">
        {% for member in site.data.former_members %}
          <li>
            {{ member.name -}}
            {%- if member.role %}
              <span class="team-role">[{{ member.role }}]</span>
            {%- endif -%}
            {%- if member.now %}, Now: {{ member.now }}{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </article>
</div>
