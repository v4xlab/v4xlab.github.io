---
layout: page
---
<div class="post">
  <article>
    {% if page.profiles %}
      {% for profile in page.profiles %}
        <hr>
        <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if profile.image %}
            {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
            {% if profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
            {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
          {% endif %}
          {% if profile.more_info %}
            <div class="more-info">{{ profile.more_info }}</div>
          {% endif %}
        </div>

        <div class="clearfix">
          {% if profile.content %}
            {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
            {{ profile_content | markdownify }}
          {% else %}
            {{ content }}
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}

    {% if site.data.phd_students %}
      <hr>
      <h2>PhD Students</h2>
      <div class="team-grid">
        {% for student in site.data.phd_students %}
          <div class="team-card">
            {% if student.photo %}
              <img
                class="team-photo"
                src="{{ student.photo }}"
                alt="{{ student.name }}"
                width="160"
                height="160"
                loading="lazy"
              >
            {% endif %}
            <div class="team-name">
              {% if student.website %}
                <a href="{{ student.website }}" target="_blank" rel="noopener noreferrer">{{ student.name }}</a>
              {% else %}
                {{ student.name }}
              {% endif %}
            </div>
            <div class="team-years">
              PhD Student{% if student.years %}, {{ student.years }}{% endif %}
            </div>
            {% if student.blurb %}
              <div class="team-blurb">{{ student.blurb }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if site.data.current_students %}
      <hr>
      <h2>Students</h2>
      <ul class="team-list">
        {% for student in site.data.current_students %}
          <li>
            {{ student.name -}}
            {%- if student.role %}
              <span class="team-role">[{{ student.role }}]</span>
            {%- endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if site.data.former_members %}
      <hr>
      <h2>Former Members</h2>
      <ul class="team-list">
        {% for member in site.data.former_members %}
          <li>
            {{ member.name -}}
            {%- if member.role %}
              <span class="team-role">[{{ member.role }}]</span>
            {%- endif -%}
            {%- if member.now %}, Now: {{ member.now }}{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </article>
</div>
